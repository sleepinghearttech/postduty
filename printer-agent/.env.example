# Copy this to .env on the local Post Duty PC. Never commit .env.
BAMBU_PRINTER_IP=192.168.0.100
BAMBU_PRINTER_SERIAL=YOUR_PRINTER_SERIAL
BAMBU_ACCESS_CODE=YOUR_LAN_ACCESS_CODE

# Bambu local MQTT commonly uses a device/self-signed certificate.
# Initial bridge support requires a trusted private LAN and explicit opt-in.
BAMBU_ALLOW_UNVERIFIED_TLS=false
